{
  "name": "pretty-md",
  "displayName": "pretty.md",
  "description": "Open Markdown files as a beautifully typeset page first. Switch between reading themes (Classic, Manuscript, Paper, Night…), present any document as animated slides, and jump to the source when you want to edit.",
  "version": "0.3.0",
  "publisher": "remogrillo",
  "author": {
    "name": "Remo Grillo"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#f4ecd8",
    "theme": "light"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RemoGrillo/pretty_md.git"
  },
  "bugs": {
    "url": "https://github.com/RemoGrillo/pretty_md/issues"
  },
  "homepage": "https://github.com/RemoGrillo/pretty_md#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "md",
    "preview",
    "reader",
    "reading mode",
    "typography",
    "theme",
    "serif",
    "sepia",
    "readme",
    "slides",
    "presentation",
    "claude code",
    "agentic coding",
    "ai",
    "documentation",
    "docs"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "prettyMd.preview",
        "displayName": "pretty.md",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "default"
      }
    ],
    "configurationDefaults": {
      "workbench.diffEditorAssociations": {
        "*.md": "default",
        "*.markdown": "default"
      },
      "workbench.editorAssociations": {
        "{git}:/**/*.{md,markdown}": "default"
      }
    },
    "commands": [
      {
        "command": "prettyMd.openPreview",
        "title": "%cmd.openPreview%",
        "category": "pretty.md",
        "icon": "$(book)"
      },
      {
        "command": "prettyMd.openPreviewToSide",
        "title": "%cmd.openPreviewToSide%",
        "category": "pretty.md",
        "icon": "$(open-preview)"
      },
      {
        "command": "prettyMd.editSource",
        "title": "%cmd.editSource%",
        "category": "pretty.md",
        "icon": "$(edit)"
      },
      {
        "command": "prettyMd.selectTheme",
        "title": "%cmd.selectTheme%",
        "category": "pretty.md",
        "icon": "$(symbol-color)"
      },
      {
        "command": "prettyMd.startSlides",
        "title": "%cmd.startSlides%",
        "category": "pretty.md",
        "icon": "$(play)"
      },
      {
        "command": "prettyMd.stopSlides",
        "title": "%cmd.stopSlides%",
        "category": "pretty.md",
        "icon": "$(debug-stop)"
      },
      {
        "command": "prettyMd.toggleOpenByDefault",
        "title": "%cmd.toggleOpenByDefault%",
        "category": "pretty.md"
      },
      {
        "command": "prettyMd.openAsText",
        "title": "%cmd.openAsText%",
        "category": "pretty.md",
        "icon": "$(file-code)"
      },
      {
        "command": "prettyMd.refreshFiles",
        "title": "%cmd.refreshFiles%",
        "category": "pretty.md",
        "icon": "$(refresh)"
      },
      {
        "command": "prettyMd.revealHeading",
        "title": "%cmd.revealHeading%",
        "category": "pretty.md"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "prettyMd.startSlides",
          "when": "activeCustomEditorId == 'prettyMd.preview' && !prettyMd.slidesActive",
          "group": "navigation@0"
        },
        {
          "command": "prettyMd.stopSlides",
          "when": "activeCustomEditorId == 'prettyMd.preview' && prettyMd.slidesActive",
          "group": "navigation@0"
        },
        {
          "command": "prettyMd.openPreview",
          "when": "resourceLangId == markdown && activeEditor == 'workbench.editors.files.textFileEditor'",
          "group": "navigation@-10"
        },
        {
          "command": "prettyMd.editSource",
          "when": "activeCustomEditorId == 'prettyMd.preview'",
          "group": "navigation@1"
        },
        {
          "command": "prettyMd.selectTheme",
          "when": "activeCustomEditorId == 'prettyMd.preview'",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "prettyMd.openPreview",
          "when": "resourceLangId == markdown",
          "group": "navigation@99"
        },
        {
          "command": "prettyMd.startSlides",
          "when": "resourceLangId == markdown",
          "group": "navigation@99"
        }
      ],
      "commandPalette": [
        {
          "command": "prettyMd.editSource",
          "when": "activeCustomEditorId == 'prettyMd.preview'"
        },
        {
          "command": "prettyMd.openPreview",
          "when": "resourceLangId == markdown || activeCustomEditorId == 'prettyMd.preview'"
        },
        {
          "command": "prettyMd.openPreviewToSide",
          "when": "resourceLangId == markdown"
        },
        {
          "command": "prettyMd.revealHeading",
          "when": "false"
        },
        {
          "command": "prettyMd.refreshFiles",
          "when": "false"
        },
        {
          "command": "prettyMd.openAsText",
          "when": "activeCustomEditorId == 'prettyMd.preview'"
        },
        {
          "command": "prettyMd.startSlides",
          "when": "resourceLangId == markdown || activeCustomEditorId == 'prettyMd.preview'"
        },
        {
          "command": "prettyMd.stopSlides",
          "when": "activeCustomEditorId == 'prettyMd.preview' && prettyMd.slidesActive"
        }
      ],
      "view/title": [
        {
          "command": "prettyMd.refreshFiles",
          "when": "view == prettyMd.files",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "prettyMd.openPreviewToSide",
          "when": "view == prettyMd.files && viewItem == prettyMd.file",
          "group": "inline"
        },
        {
          "command": "prettyMd.openPreviewToSide",
          "when": "view == prettyMd.files && viewItem == prettyMd.file",
          "group": "navigation@1"
        },
        {
          "command": "prettyMd.openAsText",
          "when": "view == prettyMd.files && viewItem == prettyMd.file",
          "group": "navigation@2"
        },
        {
          "command": "prettyMd.startSlides",
          "when": "view == prettyMd.files && viewItem == prettyMd.file",
          "group": "navigation@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "prettyMd.editSource",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "activeCustomEditorId == 'prettyMd.preview'"
      }
    ],
    "configuration": {
      "title": "pretty.md",
      "properties": {
        "prettyMd.theme": {
          "type": "string",
          "default": "classic",
          "enum": [
            "classic",
            "manuscript",
            "paper",
            "espresso",
            "night",
            "terminal",
            "vscode"
          ],
          "enumDescriptions": [
            "Classic — beige paper, dark brown ink, Garamond headings",
            "Manuscript — ivory book page, Garamond throughout, justified",
            "Paper — crisp white, modern sans (Inter)",
            "Espresso — dark classic, cream ink on roasted brown",
            "Night — deep blue, gold accents, Playfair Display headings",
            "Terminal — monospace, phosphor green on black",
            "Editor — follows your VS Code colour theme and fonts"
          ],
          "markdownDescription": "%config.theme%",
          "order": 0
        },
        "prettyMd.fontSize": {
          "type": "number",
          "default": 17,
          "minimum": 10,
          "maximum": 32,
          "markdownDescription": "%config.fontSize%",
          "order": 1
        },
        "prettyMd.contentWidth": {
          "type": "string",
          "default": "medium",
          "enum": [
            "narrow",
            "medium",
            "wide",
            "full"
          ],
          "markdownEnumDescriptions": [
            "%config.contentWidth.narrow%",
            "%config.contentWidth.medium%",
            "%config.contentWidth.wide%",
            "%config.contentWidth.full%"
          ],
          "markdownDescription": "%config.contentWidth%",
          "order": 2
        },
        "prettyMd.slideLevel": {
          "type": "number",
          "default": 3,
          "enum": [
            1,
            2,
            3,
            4,
            5,
            6
          ],
          "markdownEnumDescriptions": [
            "%config.slideLevel.1%",
            "%config.slideLevel.2%",
            "%config.slideLevel.3%",
            "%config.slideLevel.4%",
            "%config.slideLevel.5%",
            "%config.slideLevel.6%"
          ],
          "markdownDescription": "%config.slideLevel%",
          "order": 3
        },
        "prettyMd.editSourceBeside": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.editSourceBeside%",
          "order": 4
        },
        "prettyMd.scrollSync": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.scrollSync%",
          "order": 5
        },
        "prettyMd.typographer": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.typographer%",
          "order": 6
        },
        "prettyMd.breaks": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.breaks%",
          "order": 7
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prettyMd",
          "title": "pretty.md",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "prettyMd": [
        {
          "type": "webview",
          "id": "prettyMd.appearance",
          "name": "%view.appearance%"
        },
        {
          "id": "prettyMd.outline",
          "name": "%view.outline%"
        },
        {
          "id": "prettyMd.files",
          "name": "%view.files%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "prettyMd.outline",
        "contents": "%welcome.outline%"
      },
      {
        "view": "prettyMd.files",
        "contents": "%welcome.files%"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node scripts/build.mjs --production",
    "watch": "node scripts/build.mjs --watch",
    "fonts": "node scripts/build-fonts.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "samples": "node scripts/samples.mjs",
    "package": "vsce package",
    "integration": "node scripts/integration.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "morphdom": "^2.7.8",
    "ovsx": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
